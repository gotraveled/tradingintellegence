# Server-side market-data provider configuration — names only, never real values.
# Polygon.io aggregates feed (src/lib/market-data/providers/polygon.ts).
POLYGON_API_KEY=
# Optional override; defaults to https://api.polygon.io
MARKET_DATA_BASE_URL=
# Declared subscription tier: basic | starter | developer | advanced.
# Unset or unrecognized -> the capability layer infers Basic/EOD-only (daily+)
# and marks the entitlement "inferred" in system status — never an upgrade guess.
POLYGON_PLAN=
# Serving scope: public | internal.
#   public   — responses may only carry data whose capability row is
#              displayRights=authorized; unknown/not_authorized fail closed.
#              This is the default in production (NODE_ENV=production).
#   internal — development/test/internal-operation reads; capability gates
#              (markets/timeframes/history) still apply, display rights do not.
# This is the documented operator switch — there is no other bypass.
MARKET_DATA_SERVING=

# Optional local vision runtime for /api/chart-analysis narratives (Phase P1).
# Fully optional and local-only: the deterministic pixel pipeline works without
# it, images never leave this process, and any failure falls back silently.
# Example: an Ollama server (https://ollama.com) with a vision model pulled.
#   VISION_RUNTIME_URL=http://localhost:11434
#   VISION_MODEL=llava:13b
VISION_RUNTIME_URL=
VISION_MODEL=
