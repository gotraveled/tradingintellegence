# Server-side market-data provider configuration — names only, never real values.
# Polygon.io aggregates feed (src/lib/market-data/providers/polygon.ts).
POLYGON_API_KEY=
# Optional override; defaults to https://api.polygon.io
MARKET_DATA_BASE_URL=
# Declared subscription tier: basic | starter | developer | advanced.
# Unset or unrecognized -> the capability layer infers Basic/EOD-only (daily+)
# and marks the entitlement "inferred" in system status — never an upgrade guess.
POLYGON_PLAN=
